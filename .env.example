# Copy this file to .env and fill in your values.
# The .env file is read automatically by pydantic-settings at startup.

# ── Required ───────────────────────────────────────────────────────────────
# Your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Optional: OpenAI-compatible API base URL.
# Defaults to OpenRouter; set to https://polza.ai/api/v1 for Polza.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
